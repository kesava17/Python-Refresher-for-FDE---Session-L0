APP_NAME=reviews-insight
APP_ENV=dev
DATA_PATH=data/reviews_sample.csv
DATABASE_URL=postgresql://reviews_admin:change_me_in_prod@localhost:5432/reviews_db
# Shared with the third party that signs the webhook. Set a real value in each environment; the
# app falls back to a non-secret development placeholder only when this is unset.
WEBHOOK_SECRET=shared-webhook-secret
